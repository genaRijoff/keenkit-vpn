#!/bin/sh
# shellcheck shell=dash  # целевой shell — BusyBox ash (как dash: POSIX + local)
# kvn (KeenVPN) — запуск KeenKit через VPN-интерфейс с раздельными OTA-источниками:
#   п.5 OTA Update (прошивки) -> FW_DOMAIN (Афина)
#   п.8 KeenBOOT OTA Update    -> KB_BASE   (Стас); с athena-patch на aarch64 — Athena
# KeenKit не модифицируется: подменяется только curl через PATH (переживает обновления KeenKit).
#
# Использование:
#   kvn              автовыбор рабочего интерфейса из IFACES и запуск KeenKit
#   kvn nwg1         запуск через указанный интерфейс
#   kvn check        проверка каналов, источников и совместимости с KeenKit
#   kvn uninstall    удалить kvn
# Настройки: /opt/etc/kvn.conf (создаётся при первом запуске)

VERSION="0.0.5"
KK_TESTED="2.9.1 2.9.2 2.9.3 2.9.4 2.9.5"

set -u

# KVN_ROOT — только для тестов, на роутере пусто.
ROOT="${KVN_ROOT:-}"
SELF="$ROOT/opt/bin/kvn"
CONF="$ROOT/opt/etc/kvn.conf"
WRAP="$ROOT/opt/lib/kvn/curl"
KK_SCRIPT="$ROOT/opt/keenkit.sh"
KK_CONF="$ROOT/opt/etc/KeenKit.conf"
REAL_CURL="$ROOT/opt/bin/curl"
NET_DIR="$ROOT/sys/class/net"
ARCH="${KVN_ARCH:-$(uname -m)}"

# Значения по умолчанию (переопределяются в $CONF)
IFACES="nwg0 nwg1 nwg2"
FW_DOMAIN="https://osvault.project-athens.com"
FW_LABEL="Афина"
KB_BASE="https://spatiumstas.github.io/KeenKit"
KB_LABEL="Стас"

# Цвета только в терминале и без NO_COLOR (https://no-color.org)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  RED='\033[1;31m' GREEN='\033[1;32m' CYAN='\033[0;36m' YELLOW='\033[1;33m' NC='\033[0m'
else
  RED='' GREEN='' CYAN='' YELLOW='' NC=''
fi

msg() { printf '%b%s%b\n' "$CYAN" "$*" "$NC" >&2; }
warn() { printf '%b%s%b\n' "$YELLOW" "$*" "$NC" >&2; }
die() {
  printf '%b%s%b\n' "$RED" "$*" "$NC" >&2
  exit 1
}

TMP_FILE=""
cleanup() { [ -z "$TMP_FILE" ] || rm -f "$TMP_FILE"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

require() {
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "Не найдена команда: $c"
  done
}

# ---------- конфигурация ----------

write_default_conf() {
  mkdir -p "${CONF%/*}" || die "Не удалось создать ${CONF%/*}"
  cat >"$CONF" <<EOF
# kvn: интерфейсы проверяются по порядку, используется первый рабочий
IFACES="$IFACES"
# п.5 OTA Update — прошивки
FW_DOMAIN="$FW_DOMAIN"
FW_LABEL="$FW_LABEL"
# п.8 KeenBOOT OTA Update — загрузчики
KB_BASE="$KB_BASE"
KB_LABEL="$KB_LABEL"
EOF
  chmod 600 "$CONF"
}

valid_url() {
  case "$1" in
  https://*/ | *[!A-Za-z0-9.:/_-]*) return 1 ;;
  https://?*) return 0 ;;
  *) return 1 ;;
  esac
}

valid_iface_name() {
  case "$1" in
  "" | *[!A-Za-z0-9_.-]*) return 1 ;;
  *) return 0 ;;
  esac
}

iface_exists() {
  valid_iface_name "$1" && [ -d "$NET_DIR/$1" ]
}

# Конфиг читается как данные, а не исполняется: только KEY="value" из известного списка.
load_conf() {
  local line key val i
  [ -f "$CONF" ] || write_default_conf
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "" | \#*) continue ;; esac
    key=${line%%=*}
    val=${line#*=}
    case "$val" in \"*\") val=${val#\"} && val=${val%\"} ;; esac
    case "$val" in *[\"\`\$\\]*) die "$CONF: недопустимые символы в $key" ;; esac
    case "$key" in
    IFACES) IFACES=$val ;;
    FW_DOMAIN) FW_DOMAIN=$val ;;
    FW_LABEL) FW_LABEL=$val ;;
    KB_BASE) KB_BASE=$val ;;
    KB_LABEL) KB_LABEL=$val ;;
    PROBE_URL) ;; # устарел с 0.0.3, проверяются оба источника
    *) warn "$CONF: неизвестный параметр «$key», пропущен" ;;
    esac
  done <"$CONF"

  valid_url "$FW_DOMAIN" || die "FW_DOMAIN: нужен https://хост без / в конце ($FW_DOMAIN)"
  valid_url "$KB_BASE" || die "KB_BASE: нужен https://хост[/путь] без / в конце ($KB_BASE)"
  [ -n "$IFACES" ] || die "IFACES пуст"
  for i in $IFACES; do
    valid_iface_name "$i" || die "IFACES: недопустимое имя интерфейса «$i»"
  done
}

# Реальный источник п.8: athena-patch на aarch64 переводит KeenBOOT на Athena (FW_DOMAIN/files/athena).
athena_patch_version() {
  sed -n 's/^ATHENA_PATCH="\(.*\)"$/\1/p' "$KK_SCRIPT" 2>/dev/null | head -n 1
}

resolve_kb_source() {
  if [ -n "$(athena_patch_version)" ] && [ "$ARCH" = "aarch64" ]; then
    KB_URL="$FW_DOMAIN/files/athena"
    KB_NAME="$FW_LABEL"
  else
    KB_URL="$KB_BASE"
    KB_NAME="$KB_LABEL"
  fi
}

# ---------- сеть ----------

fetch() {
  "$REAL_CURL" -fsS --connect-timeout 4 -m 10 "$@"
}

# Канал рабочий, если через него доступны оба источника. Печатает причину отказа.
probe_iface() {
  local iface="$1"
  if ! fetch --interface "$iface" -o /dev/null "$KB_URL/" >/dev/null 2>&1; then
    warn "$iface: нет доступа к KeenBOOT ($KB_NAME)"
    return 1
  fi
  if ! fetch --interface "$iface" -o /dev/null "$FW_DOMAIN/osvault/" >/dev/null 2>&1; then
    warn "$iface: нет доступа к прошивкам ($FW_LABEL)"
    return 1
  fi
}

# Первый рабочий интерфейс из IFACES; отсутствующие пропускаются молча.
pick_iface() {
  local i
  for i in $IFACES; do
    iface_exists "$i" || continue
    if probe_iface "$i"; then
      echo "$i"
      return 0
    fi
  done
  return 1
}

list_ifaces() {
  local f
  for f in "$NET_DIR"/*; do printf '%s ' "${f##*/}"; done
}

# ---------- интеграция с KeenKit ----------

wrapper_body() {
  cat <<'WRAP'
#!/bin/sh
# Сгенерировано kvn, изменения будут перезаписаны.
# Внешние запросы -> через $KK_IFACE; $KK_FW/files/keenboot/* -> $KK_KB/files/keenboot/*;
# локальный RCI (127.0.0.1/localhost) -> напрямую.
REAL="${KK_REAL:-/opt/bin/curl}"
[ -n "${KK_IFACE:-}" ] || exec "$REAL" "$@"
local_call=0
n=$#
for arg do
  case "$arg" in
  http://127.0.0.1[:/]* | http://localhost[:/]*) local_call=1 ;;
  esac
  if [ -n "${KK_FW:-}" ] && [ -n "${KK_KB:-}" ]; then
    case "$arg" in
    "$KK_FW/files/keenboot" | "$KK_FW/files/keenboot/"*) arg="$KK_KB${arg#"$KK_FW"}" ;;
    esac
  fi
  set -- "$@" "$arg"
done
shift "$n"
[ "$local_call" = 1 ] && exec "$REAL" "$@"
exec "$REAL" --interface "$KK_IFACE" "$@"
WRAP
}

# Перезаписывает обёртку только при изменении содержимого (меньше записей во флеш).
install_wrapper() {
  [ "$(cat "$WRAP" 2>/dev/null)" = "$(wrapper_body)" ] && [ -x "$WRAP" ] && return 0
  mkdir -p "${WRAP%/*}" || die "Не удалось создать ${WRAP%/*}"
  TMP_FILE="$WRAP.$$"
  if ! { wrapper_body >"$TMP_FILE" && chmod 755 "$TMP_FILE" && mv -f "$TMP_FILE" "$WRAP"; }; then
    die "Не удалось записать $WRAP"
  fi
  TMP_FILE=""
}

kk_version() {
  sed -n 's/^SCRIPT_VERSION="\(.*\)"$/\1/p' "$KK_SCRIPT" 2>/dev/null | head -n 1
}

# kvn опирается на внутренности KeenKit: путь /files/keenboot/ и формат KeenKit.conf.
kk_compatible() {
  grep -q 'ota_path="/files/keenboot/' "$KK_SCRIPT" 2>/dev/null &&
    grep -qF "printf 'domain=\"%s\"" "$KK_SCRIPT" 2>/dev/null
}

# Патч v1 (без метки) заменял строку ota_path целиком
kk_athena_v1() {
  grep -q 'ota_path="/files/athena"' "$KK_SCRIPT" 2>/dev/null && [ -z "$(athena_patch_version)" ]
}

kk_domain() {
  sed -n 's/^domain="\(.*\)"$/\1/p' "$KK_CONF" 2>/dev/null | head -n 1
}

set_kk_domain() {
  [ "$(kk_domain)" = "$FW_DOMAIN" ] && return 0
  if ! { mkdir -p "${KK_CONF%/*}" && printf 'domain="%s"\n' "$FW_DOMAIN" >"$KK_CONF"; }; then
    die "Не удалось записать $KK_CONF"
  fi
}

# ---------- команды ----------

cmd_run() {
  local iface
  [ -x "$REAL_CURL" ] || die "Нет $REAL_CURL (opkg install curl)"
  [ -f "$KK_SCRIPT" ] || die "KeenKit не установлен ($KK_SCRIPT)"
  if kk_athena_v1; then
    warn "KeenKit изменён старым патчем Athena v1 — обнови: sh athena-patch.sh"
  elif ! kk_compatible; then
    warn "KeenKit $(kk_version): структура OTA изменилась, KeenBOOT может пойти не через $KB_NAME"
  fi
  if [ -n "$1" ]; then
    iface_exists "$1" || die "Интерфейс $1 не найден. Есть: $(list_ifaces)"
    IFACES="$1"
  fi
  iface=$(pick_iface) || die "Нет рабочего интерфейса ($IFACES). Проверка: kvn check"
  install_wrapper
  set_kk_domain
  printf '%bПрошивки:%b %b%s%b  %bKeenBOOT:%b %b%s%b  %bИнтерфейс:%b %b%s%b\n' \
    "$CYAN" "$NC" "$GREEN" "$FW_LABEL" "$NC" \
    "$CYAN" "$NC" "$GREEN" "$KB_NAME" "$NC" \
    "$CYAN" "$NC" "$GREEN" "$iface" "$NC"
  KK_IFACE="$iface" KK_FW="$FW_DOMAIN" KK_KB="$KB_BASE" KK_REAL="$REAL_CURL" \
    PATH="${WRAP%/*}:$PATH" exec sh "$KK_SCRIPT"
}

http_code() {
  "$REAL_CURL" -sS --connect-timeout 4 -m 10 -o /dev/null -w '%{http_code}' "$@" 2>/dev/null || true
}

status() {
  case "$1" in
  2??) printf '%bOK%b' "$GREEN" "$NC" ;;
  000 | "") printf '%bнет%b' "$RED" "$NC" ;;
  *) printf '%b%s%b' "$RED" "$1" "$NC" ;;
  esac
}

# check_row <имя> [параметры curl] — IP выхода и доступность источников через канал
check_row() {
  local name="$1" ip
  shift
  ip=$(fetch "$@" https://api.ipify.org 2>/dev/null) || ip="нет связи"
  printf '%s (%s): KeenBOOT ' "$name" "$ip"
  status "$(http_code "$@" "$KB_URL/")"
  printf ', прошивки '
  status "$(http_code "$@" "$FW_DOMAIN/osvault/")"
  printf '\n'
}

cmd_check() {
  [ -x "$REAL_CURL" ] || die "Нет $REAL_CURL"
  local v d i a
  printf '%bkvn %s%b\n' "$CYAN" "$VERSION" "$NC"
  printf 'Прошивки (%s): %s\n' "$FW_LABEL" "$FW_DOMAIN"
  printf 'KeenBOOT (%s): %s\n' "$KB_NAME" "$KB_URL"

  v=$(kk_version)
  if [ ! -f "$KK_SCRIPT" ]; then
    printf 'KeenKit: %bне установлен%b\n' "$RED" "$NC"
  elif kk_athena_v1; then
    printf 'KeenKit: %b%s — старый патч Athena v1, обнови: sh athena-patch.sh%b\n' "$YELLOW" "$v" "$NC"
  elif ! kk_compatible; then
    printf 'KeenKit: %b%s — структура OTA изменилась, нужна проверка kvn%b\n' "$RED" "$v" "$NC"
  else
    case " $KK_TESTED " in
    *" $v "*) printf 'KeenKit: %b%s OK%b\n' "$GREEN" "$v" "$NC" ;;
    *) printf 'KeenKit: %b%s (не проверялся, проверены: %s)%b\n' "$YELLOW" "$v" "$KK_TESTED" "$NC" ;;
    esac
  fi

  a=$(athena_patch_version)
  if [ -n "$a" ]; then
    if [ "$ARCH" = "aarch64" ]; then
      printf 'Athena-патч: %s (п.8 -> Athena)\n' "$a"
    else
      printf 'Athena-патч: %s (%s: п.8 без изменений)\n' "$a" "$ARCH"
    fi
  fi

  d=$(kk_domain)
  if [ "$d" = "$FW_DOMAIN" ]; then
    printf 'KeenKit.conf: %bOK%b\n' "$GREEN" "$NC"
  else
    printf 'KeenKit.conf: %b%s%b (исправится при запуске kvn)\n' "$YELLOW" "${d:-не задан}" "$NC"
  fi

  printf '\n'
  check_row "напрямую"
  for i in $IFACES; do
    if iface_exists "$i"; then check_row "$i" --interface "$i"; fi
  done
}

cmd_uninstall() {
  local answer
  printf 'Удалить kvn (%s, %s, %s)? (y/n) ' "$SELF" "${WRAP%/*}" "$CONF"
  read -r answer || exit 1
  case "$answer" in
  y | Y)
    rm -rf "${WRAP%/*}" && rm -f "$CONF" "$SELF" &&
      printf '%bУдалено. KeenKit.conf не тронут.%b\n' "$GREEN" "$NC"
    ;;
  *) msg "Отменено" ;;
  esac
}

require sed grep head cat mkdir chmod mv rm uname

case "${1:-}" in
-h | --help) sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//' ;;
-V | --version) echo "$VERSION" ;;
check) load_conf && resolve_kb_source && cmd_check ;;
uninstall) cmd_uninstall ;;
"") load_conf && resolve_kb_source && cmd_run "" ;;
-*) die "Неизвестный параметр: $1 (kvn --help)" ;;
*) load_conf && resolve_kb_source && cmd_run "$1" ;;
esac
