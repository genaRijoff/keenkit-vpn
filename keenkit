#!/bin/sh
# shellcheck shell=dash  # целевой shell — BusyBox ash (как dash: POSIX + local)
# keenkit — запуск KeenKit через доступный канал (напрямую или VPN) с раздельными OTA-источниками:
#   п.5 OTA Update (прошивки) -> FW_DOMAIN (Афина)
#   п.8 KeenBOOT OTA Update    -> KB_BASE   (Стас)
#   п.9 Athena OTA Update      -> FW_DOMAIN/files/athena (с athena-patch 0.0.4+, aarch64)
# Ставится вместо симлинка /opt/bin/keenkit; сам KeenKit (/opt/keenkit.sh) не меняется.
# Каждый внешний запрос KeenKit идёт через каналы по порядку, начиная с последнего удачного;
# при сетевой ошибке — повтор через следующий канал.
#
# Использование:
#   keenkit [аргументы]      запуск KeenKit (аргументы передаются KeenKit как есть)
#   keenkit --iface nwg1     только этот канал, без резерва (direct — напрямую)
#   keenkit --check          проверка каналов, источников и совместимости с KeenKit
#   keenkit --vpn-remove     вернуть обычный запуск KeenKit (симлинк на /opt/keenkit.sh)
#   keenkit --vpn-version    версия keenkit-vpn
# Настройки: /opt/etc/keenkit-vpn.conf
#   IFACES — каналы по порядку: direct (без туннеля), имена интерфейсов,
#            auto (все wg*/nwg*, затем awg*/nawg*, затем mitun*). По умолчанию: direct auto

# keenkit-vpn-launcher
VERSION="0.0.8"
KK_TESTED="2.9.1 2.9.2 2.9.3 2.9.4 2.9.5"

set -u

# KEENKIT_VPN_ROOT — только для тестов, на роутере пусто.
ROOT="${KEENKIT_VPN_ROOT:-}"
SELF="$ROOT/opt/bin/keenkit"
CONF="$ROOT/opt/etc/keenkit-vpn.conf"
OLD_CONF="$ROOT/opt/etc/kvn.conf"
WRAP="$ROOT/opt/lib/keenkit-vpn/curl"
STATE="$ROOT/tmp/keenkit-vpn.iface"
KK_SCRIPT="$ROOT/opt/keenkit.sh"
KK_CONF="$ROOT/opt/etc/KeenKit.conf"
REAL_CURL="$ROOT/opt/bin/curl"
NET_DIR="$ROOT/sys/class/net"
ARCH="${KEENKIT_VPN_ARCH:-$(uname -m)}"

# Значения по умолчанию (переопределяются в $CONF)
IFACES="direct auto"
OLD_DEFAULT_IFACES="nwg0 nwg1 nwg2" # значение по умолчанию до 0.0.7
FW_DOMAIN="https://osvault.project-athens.com"
FW_LABEL="Афина"
KB_BASE="https://spatiumstas.github.io/KeenKit"
KB_LABEL="Стас"

# Цвета только в терминале и без NO_COLOR (https://no-color.org)
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  RED='\033[1;31m' GREEN='\033[1;32m' CYAN='\033[0;36m' YELLOW='\033[1;33m' NC='\033[0m'
else
  RED='' GREEN='' CYAN='' YELLOW='' NC=''
fi

msg() { printf '%b%s%b\n' "$CYAN" "$*" "$NC" >&2; }
warn() { printf '%b%s%b\n' "$YELLOW" "$*" "$NC" >&2; }
die() {
  printf '%b%s%b\n' "$RED" "$*" "$NC" >&2
  exit 1
}

TMP_FILE=""
cleanup() { [ -z "$TMP_FILE" ] || rm -f "$TMP_FILE"; }
trap cleanup EXIT
trap 'exit 130' INT TERM

require() {
  for c in "$@"; do
    command -v "$c" >/dev/null 2>&1 || die "Не найдена команда: $c"
  done
}

# ---------- конфигурация ----------

write_default_conf() {
  mkdir -p "${CONF%/*}" || die "Не удалось создать ${CONF%/*}"
  cat >"$CONF" <<EOF
# keenkit-vpn: каналы по порядку; запрос идёт через последний удачный, при ошибке — через следующий.
# direct — без туннеля; auto — все wg*/nwg*, awg*/nawg*, mitun*; или имена через пробел
IFACES="$IFACES"
# п.5 OTA Update — прошивки
FW_DOMAIN="$FW_DOMAIN"
FW_LABEL="$FW_LABEL"
# п.8 KeenBOOT OTA Update — загрузчики
KB_BASE="$KB_BASE"
KB_LABEL="$KB_LABEL"
EOF
  chmod 600 "$CONF"
}

valid_url() {
  case "$1" in
  https://*/ | *[!A-Za-z0-9.:/_-]*) return 1 ;;
  https://?*) return 0 ;;
  *) return 1 ;;
  esac
}

valid_iface_name() {
  case "$1" in
  "" | *[!A-Za-z0-9_.-]*) return 1 ;;
  *) return 0 ;;
  esac
}

iface_exists() {
  valid_iface_name "$1" && [ -d "$NET_DIR/$1" ]
}

# Конфиг читается как данные, а не исполняется: только KEY="value" из известного списка.
load_conf() {
  local line key val i
  if [ ! -f "$CONF" ] && [ -f "$OLD_CONF" ]; then
    mv -f "$OLD_CONF" "$CONF" && msg "Настройки перенесены: $OLD_CONF -> $CONF"
  fi
  [ -f "$CONF" ] || write_default_conf
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "" | \#*) continue ;; esac
    key=${line%%=*}
    val=${line#*=}
    case "$val" in \"*\") val=${val#\"} && val=${val%\"} ;; esac
    case "$val" in *[\"\`\$\\]*) die "$CONF: недопустимые символы в $key" ;; esac
    case "$key" in
    IFACES) IFACES=$val ;;
    FW_DOMAIN) FW_DOMAIN=$val ;;
    FW_LABEL) FW_LABEL=$val ;;
    KB_BASE) KB_BASE=$val ;;
    KB_LABEL) KB_LABEL=$val ;;
    PROBE_URL) ;; # устарел с 0.0.3, проверяются оба источника
    *) warn "$CONF: неизвестный параметр «$key», пропущен" ;;
    esac
  done <"$CONF"

  valid_url "$FW_DOMAIN" || die "FW_DOMAIN: нужен https://хост без / в конце ($FW_DOMAIN)"
  valid_url "$KB_BASE" || die "KB_BASE: нужен https://хост[/путь] без / в конце ($KB_BASE)"
  [ -n "$IFACES" ] || die "IFACES пуст"
  for i in $IFACES; do
    valid_iface_name "$i" || die "IFACES: недопустимое имя интерфейса «$i»"
  done
  migrate_conf
}

# Конфиг со старым значением по умолчанию переводится на новое (direct auto).
# Значение, изменённое вручную, не трогается.
migrate_conf() {
  [ "$IFACES" = "$OLD_DEFAULT_IFACES" ] || return 0
  grep -qx "IFACES=\"$OLD_DEFAULT_IFACES\"" "$CONF" || return 0
  TMP_FILE="$CONF.$$"
  if sed "s/^IFACES=\"$OLD_DEFAULT_IFACES\"\$/IFACES=\"direct auto\"/" "$CONF" >"$TMP_FILE" &&
    chmod 600 "$TMP_FILE" && mv -f "$TMP_FILE" "$CONF"; then
    IFACES="direct auto"
    msg "keenkit-vpn.conf: IFACES «$OLD_DEFAULT_IFACES» -> «direct auto» (напрямую, затем все туннели)"
  else
    warn "Не удалось обновить $CONF, оставляю IFACES=\"$IFACES\""
  fi
  TMP_FILE=""
}

# Реальный источник п.8: athena-patch на aarch64 переводит KeenBOOT на Athena (FW_DOMAIN/files/athena).
athena_patch_version() {
  sed -n 's/^ATHENA_PATCH="\(.*\)"$/\1/p' "$KK_SCRIPT" 2>/dev/null | head -n 1
}

# athena-patch 0.0.4+ добавляет отдельный п.9; 0.0.2–0.0.3 переводили на Athena сам п.8
athena_menu9() {
  grep -q '^    9) ota_update "athena" ;;' "$KK_SCRIPT" 2>/dev/null
}

athena_in_menu8() {
  grep -qF '] || ota_path="/files/athena" # athena-patch' "$KK_SCRIPT" 2>/dev/null
}

resolve_kb_source() {
  if athena_in_menu8 && [ "$ARCH" = "aarch64" ]; then
    KB_URL="$FW_DOMAIN/files/athena"
    KB_NAME="$FW_LABEL"
  else
    KB_URL="$KB_BASE"
    KB_NAME="$KB_LABEL"
  fi
}

# ---------- сеть ----------

fetch() {
  "$REAL_CURL" -fsS --connect-timeout 4 -m 10 "$@"
}

iface_label() {
  if [ "$1" = "direct" ]; then echo "напрямую"; else echo "$1"; fi
}

# Список каналов из IFACES: direct, существующие интерфейсы, auto -> wg*/nwg*, awg*/nawg*, mitun*.
# Порядок сохраняется, повторы и отсутствующие интерфейсы отбрасываются.
expand_ifaces() {
  local out="" i f n fam
  for i in $IFACES; do
    case "$i" in
    auto)
      for fam in wg awg mitun; do
        for f in "$NET_DIR"/*; do
          [ -d "$f" ] || continue
          n=${f##*/}
          case "$fam:$n" in
          wg:wg* | wg:nwg* | awg:awg* | awg:nawg* | mitun:mitun*) ;;
          *) continue ;;
          esac
          case " $out " in *" $n "*) ;; *) out="$out $n" ;; esac
        done
      done
      ;;
    direct)
      case " $out " in *" direct "*) ;; *) out="$out direct" ;; esac
      ;;
    *)
      iface_exists "$i" || continue
      case " $out " in *" $i "*) ;; *) out="$out $i" ;; esac
      ;;
    esac
  done
  echo "${out# }"
}

list_ifaces() {
  local f
  for f in "$NET_DIR"/*; do printf '%s ' "${f##*/}"; done
}

# ---------- интеграция с KeenKit ----------

wrapper_body() {
  cat <<'WRAP'
#!/bin/sh
# Сгенерировано keenkit-vpn (/opt/bin/keenkit), изменения будут перезаписаны.
# Внешние запросы идут через каналы $KK_IFACES по порядку (direct = без --interface), начиная
# с последнего удачного ($KK_STATE). Сетевая ошибка -> повтор через следующий канал; ответ
# сервера (404 и т.п.) не повторяется. $KK_FW/files/keenboot/* -> $KK_KB/files/keenboot/*.
# Локальный RCI (127.0.0.1/localhost) — напрямую.
REAL="${KK_REAL:-/opt/bin/curl}"
ifaces="${KK_IFACES:-${KK_IFACE:-}}"
[ -n "$ifaces" ] || exec "$REAL" "$@"
local_call=0
n=$#
for arg do
  case "$arg" in
  http://127.0.0.1[:/]* | http://localhost[:/]*) local_call=1 ;;
  esac
  if [ -n "${KK_FW:-}" ] && [ -n "${KK_KB:-}" ]; then
    case "$arg" in
    "$KK_FW/files/keenboot" | "$KK_FW/files/keenboot/"*) arg="$KK_KB${arg#"$KK_FW"}" ;;
    esac
  fi
  set -- "$@" "$arg"
done
shift "$n"
[ "$local_call" = 1 ] && exec "$REAL" "$@"

state="${KK_STATE:-}"
if [ -n "$state" ] && [ -r "$state" ] && read -r last <"$state"; then
  case " $ifaces " in
  *" $last "*)
    rest=""
    for i in $ifaces; do [ "$i" = "$last" ] || rest="$rest $i"; done
    ifaces="$last$rest"
    ;;
  esac
fi

out=$(mktemp "${TMPDIR:-/tmp}/keenkit-vpn-out.XXXXXX") || exit 1
err=$(mktemp "${TMPDIR:-/tmp}/keenkit-vpn-err.XXXXXX") || { rm -f "$out"; exit 1; }
trap 'rm -f "$out" "$err"' EXIT
trap 'exit 130' INT TERM

rc=1
left=$(echo "$ifaces" | wc -w)
for i in $ifaces; do
  left=$((left - 1))
  if [ "$i" = "direct" ]; then
    "$REAL" "$@" >"$out" 2>"$err"
  else
    "$REAL" --interface "$i" "$@" >"$out" 2>"$err"
  fi
  rc=$?
  case "$rc" in
  5 | 6 | 7 | 16 | 28 | 35 | 52 | 55 | 56)
    if [ "$left" -gt 0 ]; then
      [ "$i" = "direct" ] && i="напрямую"
      printf 'keenkit-vpn: %s не отвечает (curl %s), повтор через следующий канал\n' "$i" "$rc" >&2
      continue
    fi
    ;;
  esac
  break
done
if [ "$rc" -eq 0 ] && [ -n "$state" ]; then
  printf '%s\n' "$i" >"$state" 2>/dev/null || true
fi
cat "$out"
cat "$err" >&2
exit "$rc"
WRAP
}

# Перезаписывает обёртку только при изменении содержимого (меньше записей во флеш).
install_wrapper() {
  [ "$(cat "$WRAP" 2>/dev/null)" = "$(wrapper_body)" ] && [ -x "$WRAP" ] && return 0
  mkdir -p "${WRAP%/*}" || return 1
  TMP_FILE="$WRAP.$$"
  if ! { wrapper_body >"$TMP_FILE" && chmod 755 "$TMP_FILE" && mv -f "$TMP_FILE" "$WRAP"; }; then
    rm -f "$TMP_FILE"
    TMP_FILE=""
    return 1
  fi
  TMP_FILE=""
}

kk_version() {
  sed -n 's/^SCRIPT_VERSION="\(.*\)"$/\1/p' "$KK_SCRIPT" 2>/dev/null | head -n 1
}

# keenkit-vpn опирается на внутренности KeenKit: путь /files/keenboot/ и формат KeenKit.conf.
kk_compatible() {
  grep -q 'ota_path="/files/keenboot/' "$KK_SCRIPT" 2>/dev/null &&
    grep -qF "printf 'domain=\"%s\"" "$KK_SCRIPT" 2>/dev/null
}

# Патч v1 (без метки) заменял строку ota_path целиком
kk_athena_v1() {
  grep -q 'ota_path="/files/athena"' "$KK_SCRIPT" 2>/dev/null && [ -z "$(athena_patch_version)" ]
}

kk_domain() {
  sed -n 's/^domain="\(.*\)"$/\1/p' "$KK_CONF" 2>/dev/null | head -n 1
}

set_kk_domain() {
  [ "$(kk_domain)" = "$FW_DOMAIN" ] && return 0
  mkdir -p "${KK_CONF%/*}" && printf 'domain="%s"\n' "$FW_DOMAIN" >"$KK_CONF"
}

# ---------- команды ----------

# Запуск KeenKit. Ошибки keenkit-vpn не мешают запуску: в худшем случае KeenKit стартует как обычно.
cmd_run() {
  local cands i labels
  [ -f "$KK_SCRIPT" ] || die "KeenKit не установлен ($KK_SCRIPT)"
  if [ ! -x "$REAL_CURL" ]; then
    warn "keenkit-vpn: нет $REAL_CURL — KeenKit запускается без выбора канала"
    exec sh "$KK_SCRIPT" "$@"
  fi
  if kk_athena_v1; then
    warn "KeenKit изменён старым патчем Athena v1 — обнови: athena-patch"
  elif ! kk_compatible; then
    warn "KeenKit $(kk_version): структура OTA изменилась, KeenBOOT может пойти не через $KB_NAME"
  fi
  if [ -n "$FORCE_IFACE" ]; then
    cands="$FORCE_IFACE"
  else
    cands=$(expand_ifaces)
    if [ -z "$cands" ]; then
      warn "keenkit-vpn: ни одного канала из IFACES=\"$IFACES\" нет на роутере — только напрямую"
      cands="direct"
    fi
  fi
  if ! install_wrapper; then
    warn "keenkit-vpn: не удалось записать $WRAP — KeenKit запускается без выбора канала"
    exec sh "$KK_SCRIPT" "$@"
  fi
  set_kk_domain || warn "keenkit-vpn: не удалось записать $KK_CONF"
  labels=""
  for i in $cands; do labels="$labels -> $(iface_label "$i")"; done
  printf '%bПрошивки:%b %b%s%b  %bKeenBOOT:%b %b%s%b' \
    "$CYAN" "$NC" "$GREEN" "$FW_LABEL" "$NC" \
    "$CYAN" "$NC" "$GREEN" "$KB_NAME" "$NC"
  if athena_menu9 && [ "$ARCH" = "aarch64" ]; then
    printf '  %bAthena:%b %bп.9%b' "$CYAN" "$NC" "$GREEN" "$NC"
  fi
  printf '  %bКаналы:%b %b%s%b\n' "$CYAN" "$NC" "$GREEN" "${labels# -> }" "$NC"
  mkdir -p "${STATE%/*}" 2>/dev/null || true
  KK_IFACES="$cands" KK_STATE="$STATE" KK_FW="$FW_DOMAIN" KK_KB="$KB_BASE" KK_REAL="$REAL_CURL" \
    PATH="${WRAP%/*}:$PATH" exec sh "$KK_SCRIPT" "$@"
}

http_code() {
  "$REAL_CURL" -sS --connect-timeout 4 -m 10 -o /dev/null -w '%{http_code}' "$@" 2>/dev/null || true
}

status() {
  case "$1" in
  2??) printf '%bOK%b' "$GREEN" "$NC" ;;
  000 | "") printf '%bнет%b' "$RED" "$NC" ;;
  *) printf '%b%s%b' "$RED" "$1" "$NC" ;;
  esac
}

# check_row <имя> [параметры curl] — IP выхода и доступность источников через канал
check_row() {
  local name="$1" ip
  shift
  ip=$(fetch "$@" https://api.ipify.org 2>/dev/null) || ip="нет связи"
  printf '%s (%s): KeenBOOT ' "$name" "$ip"
  status "$(http_code "$@" "$KB_URL/")"
  printf ', прошивки '
  status "$(http_code "$@" "$FW_DOMAIN/osvault/")"
  printf '\n'
}

cmd_check() {
  [ -x "$REAL_CURL" ] || die "Нет $REAL_CURL"
  local v d i a cands labels
  printf '%bkeenkit-vpn %s%b\n' "$CYAN" "$VERSION" "$NC"
  printf 'Прошивки (%s): %s\n' "$FW_LABEL" "$FW_DOMAIN"
  printf 'KeenBOOT (%s): %s\n' "$KB_NAME" "$KB_URL"

  v=$(kk_version)
  if [ ! -f "$KK_SCRIPT" ]; then
    printf 'KeenKit: %bне установлен%b\n' "$RED" "$NC"
  elif kk_athena_v1; then
    printf 'KeenKit: %b%s — старый патч Athena v1, обнови: athena-patch%b\n' "$YELLOW" "$v" "$NC"
  elif ! kk_compatible; then
    printf 'KeenKit: %b%s — структура OTA изменилась, нужна проверка keenkit-vpn%b\n' "$RED" "$v" "$NC"
  else
    case " $KK_TESTED " in
    *" $v "*) printf 'KeenKit: %b%s OK%b\n' "$GREEN" "$v" "$NC" ;;
    *) printf 'KeenKit: %b%s (не проверялся, проверены: %s)%b\n' "$YELLOW" "$v" "$KK_TESTED" "$NC" ;;
    esac
  fi

  a=$(athena_patch_version)
  if [ -n "$a" ]; then
    if [ "$ARCH" != "aarch64" ]; then
      printf 'Athena-патч: %s (%s: Athena недоступна)\n' "$a" "$ARCH"
    elif athena_menu9; then
      printf 'Athena-патч: %s (п.9 -> Athena, %s)\n' "$a" "$FW_DOMAIN/files/athena"
    else
      printf 'Athena-патч: %s (п.8 -> Athena; обнови: athena-patch)\n' "$a"
    fi
  fi

  d=$(kk_domain)
  if [ "$d" = "$FW_DOMAIN" ]; then
    printf 'KeenKit.conf: %bOK%b\n' "$GREEN" "$NC"
  else
    printf 'KeenKit.conf: %b%s%b (исправится при запуске keenkit)\n' "$YELLOW" "${d:-не задан}" "$NC"
  fi

  cands=$(expand_ifaces)
  labels=""
  for i in $cands; do labels="$labels -> $(iface_label "$i")"; done
  printf 'Порядок каналов: %s\n' "${labels# -> }"
  if [ -r "$STATE" ] && read -r i <"$STATE"; then
    printf 'Последний удачный: %s\n' "$(iface_label "$i")"
  fi
  printf '\n'
  check_row "напрямую"
  for i in $cands; do
    [ "$i" = "direct" ] || check_row "$i" --interface "$i"
  done
}

cmd_remove() {
  local answer
  printf 'Вернуть обычный запуск KeenKit (%s -> %s) и удалить %s, %s? (y/n) ' \
    "$SELF" "${KK_SCRIPT#"$ROOT"}" "${WRAP%/*}" "$CONF"
  read -r answer || exit 1
  case "$answer" in
  y | Y)
    if ln -sf "${KK_SCRIPT#"$ROOT"}" "$SELF.new.$$" && mv -f "$SELF.new.$$" "$SELF"; then
      rm -rf "${WRAP%/*}"
      rm -f "$CONF" "$STATE"
      printf '%bГотово: keenkit снова запускает KeenKit напрямую. KeenKit.conf не тронут.%b\n' "$GREEN" "$NC"
    else
      rm -f "$SELF.new.$$"
      die "Не удалось вернуть симлинк $SELF"
    fi
    ;;
  *) msg "Отменено" ;;
  esac
}

require sed grep head cat mkdir chmod mv rm uname ln

FORCE_IFACE=""
case "${1:-}" in
--vpn-help) sed -n '3,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
--vpn-version) echo "$VERSION" ;;
--check) load_conf && resolve_kb_source && cmd_check ;;
--vpn-remove) cmd_remove ;;
--iface)
  [ -n "${2:-}" ] || die "Укажи канал: keenkit --iface nwg1 (или direct)"
  [ "$2" = "direct" ] || iface_exists "$2" || die "Интерфейс $2 не найден. Есть: $(list_ifaces)"
  FORCE_IFACE="$2"
  shift 2
  load_conf && resolve_kb_source && cmd_run "$@"
  ;;
*)
  # Ошибка в настройках не должна мешать запуску KeenKit
  if ! (load_conf) >/dev/null; then
    warn "keenkit-vpn: ошибка в $CONF — KeenKit запускается без выбора канала"
    [ -f "$KK_SCRIPT" ] || die "KeenKit не установлен ($KK_SCRIPT)"
    exec sh "$KK_SCRIPT" "$@"
  fi
  load_conf && resolve_kb_source && cmd_run "$@"
  ;;
esac
